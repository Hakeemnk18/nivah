# Backend API base URL
VITE_API_BASE_URL=http://localhost:4005/api/v1

# Cloudinary (unsigned client-side uploads)
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_API_KEY=your_cloudinary_api_key
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset

# Razorpay checkout keys (public key IDs — safe to expose client-side)
VITE_RAZORPAY_KEY_ID=your_razorpay_live_key_id
VITE_RAZORPAY_TEST_KEY_ID=your_razorpay_test_key_id

# "test" for local development (no webhook needed), "live" for production
# Must match backend's PAYMENT_MODE
VITE_PAYMENT_MODE=test
