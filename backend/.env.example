# Server
PORT=4005

# MongoDB connection string (e.g. from MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database-name>

# Auth
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
REFRESH_RATE_LIMIT_WINDOW=60000
REFRESH_RATE_LIMIT_MAX=5

# Cloudinary (image storage & delivery)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Flat shipping fee added to every order
DELIVERY_CHARGE=50

# Razorpay — live keys, used when PAYMENT_MODE=live
RAZORPAY_KEY_ID=your_razorpay_live_key_id
RAZORPAY_KEY_SECRET=your_razorpay_live_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Razorpay — test keys, used when PAYMENT_MODE=test
RAZORPAY_TEST_KEY_ID=your_razorpay_test_key_id
RAZORPAY_TEST_KEY_SECRET=your_razorpay_test_key_secret

# "test" for local development (no webhook needed), "live" for production
PAYMENT_MODE=test

# Resend (transactional email — order confirmations & admin alerts)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=YourBrand <orders@yourdomain.com>
ADMIN_EMAIL=admin@yourdomain.com
